<launch>
  <arg name="detection_rect" default="/detection/lidar_euclidean/objects"/>
  <arg name="tracked_rect" default="/perception/bytetrack3d/objects"/>
  <arg name="bytetrack_param_path" default="$(find bytetrack3D)/config/bytetrack3D.param.yaml"/>

  <node pkg="bytetrack3D" type="bytetrack3D_node" name="bytetrack3D" output="screen">
    <remap from="~/in/objects" to="$(arg detection_rect)"/>
    <remap from="~/out/objects" to="$(arg tracked_rect)"/>
    <rosparam command="load" file="$(arg bytetrack_param_path)"/>
  </node>

  <node pkg="detected_objects_visualizer" type="visualize_detected_objects" name="cluster_detect_visualization_01"
        output="screen" ns="/perception/bytetrack3d/">
    <param name="objects_src_topic" value="/objects"/>
  </node>
</launch>
